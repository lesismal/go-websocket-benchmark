ARG GO_IMAGE=golang:1.27-bookworm
FROM ${GO_IMAGE}

# Where the build downloads from; empty means the upstream default. Set by
# script/docker_benchmark.sh from its DOCKER_BENCH_* variables, which
# script/docker_benchmark_cn.sh points at mirrors reachable from mainland China.
# Build arguments only: none of them is left in the image's environment, and
# the benchmark itself runs with --network none.
#   APT_MIRROR     replaces http://deb.debian.org, e.g. https://mirrors.aliyun.com
#   GO_PROXY       GOPROXY for go mod download, e.g. https://goproxy.cn
#   GITHUB_MIRROR  space-separated prefixes tried in order before
#                  https://github.com/ for the native dependencies, e.g.
#                  https://ghfast.top/https://github.com/; every download is
#                  checked against a pinned SHA-256 (script/docker_fetch_deps.sh)
#   RUSTUP_DIST_SERVER replaces https://static.rust-lang.org for the Rust
#                  toolchain, e.g. https://rsproxy.cn
#   CARGO_REGISTRY a sparse index standing in for crates.io, e.g.
#                  sparse+https://rsproxy.cn/index/; every crate is checked
#                  against Cargo.lock (script/docker_rust.sh)
ARG APT_MIRROR=
ARG GO_PROXY=
ARG GITHUB_MIRROR=
ARG RUSTUP_DIST_SERVER=
ARG CARGO_REGISTRY=

RUN if [ -n "$APT_MIRROR" ]; then \
        for f in /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do \
            if [ -f "$f" ]; then \
                sed -i "s|http://deb.debian.org|$APT_MIRROR|g; s|http://security.debian.org|$APT_MIRROR|g" "$f"; \
            fi; \
        done; \
    fi \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        libcurl4-openssl-dev \
        procps \
        psmisc \
        python3 \
        util-linux \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# The Rust toolchain benchcli-rust and frameworks/tokio_tungstenite build with, pinned in
# script/docker_rust.sh. Ahead of everything that changes more often than it.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
COPY script/docker_rust.sh /tmp/docker_rust.sh
RUN bash /tmp/docker_rust.sh install

WORKDIR /workspace

COPY go.mod go.sum ./
RUN if [ -n "$GO_PROXY" ]; then export GOPROXY="$GO_PROXY"; fi \
    && go mod download

# Cache pinned native dependencies in the image. The benchmark build script
# consumes these paths without requiring network access at container runtime.
# Copied on its own ahead of the rest of the tree, so an edit elsewhere does
# not download them again.
COPY script/docker_fetch_deps.sh /tmp/docker_fetch_deps.sh
RUN bash /tmp/docker_fetch_deps.sh /workspace && rm /tmp/docker_fetch_deps.sh

# The crates benchcli-rust's and tokio_tungstenite's Cargo.lock files pin, likewise,
# into CARGO_HOME, where the offline builds below find them.
COPY benchcli-rust/Cargo.toml benchcli-rust/Cargo.lock /tmp/benchcli-rust/
COPY frameworks/tokio_tungstenite/Cargo.toml frameworks/tokio_tungstenite/Cargo.lock /tmp/tokio_tungstenite/
RUN bash /tmp/docker_rust.sh fetch /tmp/benchcli-rust /tmp/tokio_tungstenite \
    && rm -rf /tmp/docker_rust.sh /tmp/benchcli-rust /tmp/tokio_tungstenite

COPY . .

# CARGO_NET_OFFLINE: the benchmark runs with --network none, and cargo would
# otherwise try the registry before settling for what is already fetched.
ENV GOCACHE=/tmp/go-build-cache \
    BUILD_DIR=/tmp/benchcli-uwscpp-build \
    CARGO_NET_OFFLINE=true

CMD ["bash", "script/benchmark.sh"]
